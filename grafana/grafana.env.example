# Grafana SMTP — OPTIONAL. Leave GF_SMTP_ENABLED=false to disable email alerts.
# To enable, set GF_SMTP_ENABLED=true and fill in your SMTP provider's details
# (matching what you used in lightning/web.env).
GF_SMTP_ENABLED=false
GF_SMTP_HOST=sandbox.smtp.mailtrap.io:587
GF_SMTP_USER=
GF_SMTP_FROM_ADDRESS=no-reply@example.org
GF_SMTP_FROM_NAME=OpenFn Grafana Alerts
