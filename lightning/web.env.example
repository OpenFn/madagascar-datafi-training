PORT=4000
DISABLE_DB_SSL=true
LISTEN_ADDRESS=0.0.0.0
URL_HOST=localhost
URL_PORT=4000
URL_SCHEME=http
ORIGINS=//localhost:4000
WORKER_MAX_RUN_DURATION_SECONDS=7200

# Monitoring
PROMEX_ENABLED=true
PROMEX_EXPENSIVE_METRICS_ENABLED=false
PROMEX_ENDPOINT_SCHEME=http
PROMEX_METRICS_ENDPOINT_AUTHORIZATION_REQUIRED=true
PROMEX_UPLOAD_GRAFANA_DASHBOARDS_ON_START=true
PROMEX_GRAFANA_HOST=http://grafana:3000

# Email. Optional. Leave commented to disable email; Lightning works fine without it.
# To enable, uncomment and fill in. See README section 9.
#MAIL_PROVIDER=smtp
#SMTP_RELAY=sandbox.smtp.mailtrap.io
#SMTP_PORT=587
#SMTP_TLS=true
#SMTP_USERNAME=
#SMTP_PASSWORD=
#EMAIL_ADMIN=no-reply@example.org
