#!/usr/bin/env bash
#
# generate_secrets — Generate the runtime secret files from the .example
# templates in this directory. Idempotent: re-runs preserve existing values
# unless --force is passed.
#
# Run this once after cloning, then `docker compose up -d`.
#
# Usage:
#   ./generate_secrets            # Generate any missing secrets, keep existing ones
#   ./generate_secrets --force    # Re-generate everything (backups will be created)

set -euo pipefail

cd "$(dirname "$0")"

FORCE=false
if [ "${1:-}" = "--force" ]; then FORCE=true; fi

# ---- helpers ----------------------------------------------------------------

base64_encode() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    base64 -i "$1" | tr -d '\n'
  else
    base64 -w0 "$1"
  fi
}

read_env_value() {
  grep "^$2=" "$1" 2>/dev/null | head -1 | cut -d '=' -f2- || true
}

backup_if_force() {
  local file="$1"
  if [ "$FORCE" = true ] && [ -f "$file" ]; then
    local ts; ts="$(date +%Y%m%d_%H%M%S)"
    cp "$file" "$file.bak.$ts"
    echo "  Backed up $file -> $file.bak.$ts"
  fi
}

needs_generate() {
  local file="$1"
  if [ -f "$file" ] && [ "$FORCE" = false ]; then
    echo "  Keeping existing $file"
    return 1
  fi
  backup_if_force "$file"
  return 0
}

# Render <template> -> <output>, substituting __KEY__ placeholders from env.
render_template() {
  local template="$1" output="$2"
  local tmp; tmp="$(mktemp "${output}.tmp.XXXXXX")"
  # Use perl for portable in-place substitution from env vars
  perl -pe 's/__([A-Z0-9_]+)__/defined $ENV{$1} ? $ENV{$1} : $&/ge' "$template" > "$tmp"
  mv "$tmp" "$output"
}

echo "Generating secrets in $(pwd)"
echo ""

# Ensure directories that only contain gitignored files exist after a fresh clone.
mkdir -p postgres caddy/certs



# ---- core secrets -----------------------------------------------------------

# Postgres password (alphanumeric for safety in URL strings)
if needs_generate postgres/postgres_password.txt; then
  POSTGRES_PASSWORD="$(openssl rand -base64 16 | tr -cd '[:alnum:]')"
  echo "$POSTGRES_PASSWORD" > postgres/postgres_password.txt
  echo "  Created postgres/postgres_password.txt"
else
  POSTGRES_PASSWORD="$(cat postgres/postgres_password.txt)"
fi
export POSTGRES_PASSWORD

# Worker RSA keypair (used to sign run tokens)
if needs_generate worker/worker_runs_private_key.pem; then
  openssl genpkey -algorithm RSA \
    -out worker/worker_runs_private_key.pem \
    -pkeyopt rsa_keygen_bits:2048 2>/dev/null
  openssl rsa -pubout \
    -in worker/worker_runs_private_key.pem \
    -out worker/worker_runs_public_key.pem 2>/dev/null
  echo "  Created worker/worker_runs_{private,public}_key.pem"
fi

export WORKER_RUNS_PRIVATE_KEY="$(base64_encode worker/worker_runs_private_key.pem)"
export WORKER_RUNS_PUBLIC_KEY="$(base64_encode worker/worker_runs_public_key.pem)"

# Lightning core secrets — reuse from existing web.secrets.env if present
if [ -f lightning/web.secrets.env ] && [ "$FORCE" = false ]; then
  PRIMARY_ENCRYPTION_KEY="$(read_env_value lightning/web.secrets.env PRIMARY_ENCRYPTION_KEY)"
  SECRET_KEY_BASE="$(read_env_value lightning/web.secrets.env SECRET_KEY_BASE)"
  WORKER_SECRET="$(read_env_value lightning/web.secrets.env WORKER_SECRET)"
  PROMEX_METRICS_TOKEN="$(read_env_value lightning/web.secrets.env PROMEX_METRICS_ENDPOINT_TOKEN)"
  GRAFANA_ADMIN_PASSWORD="$(read_env_value lightning/web.secrets.env PROMEX_GRAFANA_PASSWORD)"
  echo "  Reusing existing core secrets from lightning/web.secrets.env"
else
  backup_if_force lightning/web.secrets.env
  PRIMARY_ENCRYPTION_KEY="$(openssl rand -base64 32)"
  SECRET_KEY_BASE="$(openssl rand -base64 64 | tr -d '[:space:]')"
  WORKER_SECRET="$(openssl rand -base64 32)"
  PROMEX_METRICS_TOKEN="$(openssl rand -hex 32)"
  GRAFANA_ADMIN_PASSWORD="$(openssl rand -hex 32)"
  echo "  Generated new core secrets"
fi
export PRIMARY_ENCRYPTION_KEY SECRET_KEY_BASE WORKER_SECRET PROMEX_METRICS_TOKEN GRAFANA_ADMIN_PASSWORD

# Prometheus → Lightning bearer token (kept in sync with web.secrets.env)
echo "$PROMEX_METRICS_TOKEN" > prometheus/prometheus_lightning_token.txt
echo "  Wrote prometheus/prometheus_lightning_token.txt"

# Postgres exporter DSN (uses the same password as Postgres)
cat > postgres/postgres_exporter.secrets.env <<EOF
DATA_SOURCE_NAME=postgresql://lightning:${POSTGRES_PASSWORD}@postgres:5432/lightning?sslmode=disable
EOF
echo "  Wrote postgres/postgres_exporter.secrets.env"

# ---- render env files from templates ----------------------------------------

# web.env — copy from template if missing; never overwrite a user-edited file
if [ ! -f lightning/web.env ]; then
  cp lightning/web.env.example lightning/web.env
  echo "  Created lightning/web.env from template"
else
  echo "  Keeping existing lightning/web.env (edit it directly to change config)"
fi

# worker.env — same treatment
if [ ! -f worker/worker.env ]; then
  cp worker/worker.env.example worker/worker.env
  echo "  Created worker/worker.env from template"
else
  echo "  Keeping existing worker/worker.env"
fi

# grafana.env — same treatment
if [ ! -f grafana/grafana.env ]; then
  cp grafana/grafana.env.example grafana/grafana.env
  echo "  Created grafana/grafana.env from template"
else
  echo "  Keeping existing grafana/grafana.env"
fi

# Secret env files — always re-rendered from templates so generated secrets land
render_template lightning/web.secrets.env.example lightning/web.secrets.env
echo "  Wrote lightning/web.secrets.env"

render_template worker/worker.secrets.env.example worker/worker.secrets.env
echo "  Wrote worker/worker.secrets.env"

render_template grafana/grafana.secrets.env.example grafana/grafana.secrets.env
echo "  Wrote grafana/grafana.secrets.env"

echo ""
echo "Done. Next: docker compose up -d"
echo ""
echo "Useful credentials (also kept in the files above):"
echo "  Grafana admin user: admin"
echo "  Grafana admin password: $GRAFANA_ADMIN_PASSWORD"
